{
  "info": {
    "name": "Collaborative To-Do List API",
    "description": "REST API for managing tasks with full CRUD operations.\n\nBase URL: http://localhost:3000/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => { pm.response.to.have.status(201); });",
              "pm.test('Response has success true', () => { pm.expect(pm.response.json().success).to.be.true; });",
              "pm.test('Response has _id', () => { pm.expect(pm.response.json().data).to.have.property('_id'); });",
              "pm.test('Response has createdAt and updatedAt', () => { const d = pm.response.json().data; pm.expect(d).to.have.property('createdAt'); pm.expect(d).to.have.property('updatedAt'); });",
              "pm.environment.set('taskId', pm.response.json().data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Complete assignment\",\n  \"description\": \"Finish REST API project\",\n  \"isCompleted\": false,\n  \"dueDate\": \"2026-08-30T18:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        }
      }
    },
    {
      "name": "Create Task - Missing Title",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400', () => { pm.response.to.have.status(400); });",
              "pm.test('Response has success false', () => { pm.expect(pm.response.json().success).to.be.false; });",
              "pm.test('Response has error message', () => { pm.expect(pm.response.json().message).to.be.a('string'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"This task has no title\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        }
      }
    },
    {
      "name": "Create Task - Title Too Long",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400', () => { pm.response.to.have.status(400); });",
              "pm.test('Response has success false', () => { pm.expect(pm.response.json().success).to.be.false; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        }
      }
    },
    {
      "name": "Get All Tasks",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => { pm.response.to.have.status(200); });",
              "pm.test('Response has success true', () => { pm.expect(pm.response.json().success).to.be.true; });",
              "pm.test('Response has count and data array', () => { const r = pm.response.json(); pm.expect(r).to.have.property('count'); pm.expect(r.data).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        }
      }
    },
    {
      "name": "Get Completed Tasks",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => { pm.response.to.have.status(200); });",
              "pm.test('All returned tasks are completed', () => { pm.response.json().data.forEach(t => pm.expect(t.isCompleted).to.be.true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks?completed=true",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"],
          "query": [
            {
              "key": "completed",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "Get Incomplete Tasks",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => { pm.response.to.have.status(200); });",
              "pm.test('All returned tasks are incomplete', () => { pm.response.json().data.forEach(t => pm.expect(t.isCompleted).to.be.false); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks?completed=false",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"],
          "query": [
            {
              "key": "completed",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "Get Task By ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => { pm.response.to.have.status(200); });",
              "pm.test('Response has task data', () => { pm.expect(pm.response.json().data).to.have.property('_id'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "Get Task - Not Found",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 404', () => { pm.response.to.have.status(404); });",
              "pm.test('Response has success false', () => { pm.expect(pm.response.json().success).to.be.false; });",
              "pm.test('Response message says Task not found', () => { pm.expect(pm.response.json().message).to.include('Task not found'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/000000000000000000000000",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "000000000000000000000000"]
        }
      }
    },
    {
      "name": "Get Task - Invalid ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400', () => { pm.response.to.have.status(400); });",
              "pm.test('Response has success false', () => { pm.expect(pm.response.json().success).to.be.false; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/notavalidid",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "notavalidid"]
        }
      }
    },
    {
      "name": "Update Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => { pm.response.to.have.status(200); });",
              "pm.test('Response has updated data', () => { pm.expect(pm.response.json().data.title).to.equal('Updated assignment'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated assignment\",\n  \"description\": \"Updated description\",\n  \"isCompleted\": true,\n  \"dueDate\": \"2026-09-15T12:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "Update Task - Invalid Data",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400', () => { pm.response.to.have.status(400); });",
              "pm.test('Response has success false', () => { pm.expect(pm.response.json().success).to.be.false; });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "Update Task - Not Found",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 404', () => { pm.response.to.have.status(404); });",
              "pm.test('Response has success false', () => { pm.expect(pm.response.json().success).to.be.false; });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ghost task\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/000000000000000000000000",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "000000000000000000000000"]
        }
      }
    },
    {
      "name": "Delete Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 204', () => { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "Delete Task - Not Found",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 404', () => { pm.response.to.have.status(404); });",
              "pm.test('Response has success false', () => { pm.expect(pm.response.json().success).to.be.false; });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/000000000000000000000000",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "000000000000000000000000"]
        }
      }
    }
  ]
}
